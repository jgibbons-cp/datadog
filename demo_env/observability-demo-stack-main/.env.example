# ---------------------------------------------------------------------------
# Demo identity -- change these to rebrand the whole stack
# ---------------------------------------------------------------------------
# Lowercase, no spaces. Drives service names, database names, the Kubernetes
# namespace, the kind cluster name, DBM host identities and Datadog tags.
DEMO_NAME=northwind

# Shown in the storefront header and used as the RUM application service name.
DEMO_BRAND=""Northwind Wellness""

# ---------------------------------------------------------------------------
# Datadog  --  fill these in before starting the stack
# ---------------------------------------------------------------------------
DD_API_KEY=replace_with_your_datadog_api_key
DD_SITE=datadoghq.com

# Only needed by k8s/register-catalog.sh, to register Software Catalog
# ownership. Create one at Organization Settings -> Application Keys.
DD_APP_KEY=replace_with_your_datadog_app_key

# RUM: create a Browser application in Datadog (Digital Experience > RUM
# Applications > New Application > Browser). The application ID is a UUID.
DD_RUM_APPLICATION_ID=replace_with_rum_application_id
DD_RUM_CLIENT_TOKEN=replace_with_rum_client_token

# ---------------------------------------------------------------------------
# Database credentials (local demo only -- do not reuse anywhere real)
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=demo_root_pw
MYSQL_APP_PASSWORD=demo_app_pw
MYSQL_DD_PASSWORD=demo_dd_pw

POSTGRES_ROOT_PASSWORD=demo_root_pw
POSTGRES_APP_PASSWORD=demo_app_pw
POSTGRES_DD_PASSWORD=demo_dd_pw
